# Prepared TOTP gate for /_admin/ only.
# This file is not included by nginx. Do not rename or include it until the
# owner has scanned the enrollment QR and confirmed authenticator codes work.
#
# It does not cover /api/, /webclient/, /ws/, /companion/, or any path the
# native apps and browser client use.
#
# To enable, after the QR has been scanned:
#   sudo cp /etc/nginx/snippets/sda-admin-2fa.conf.disabled /etc/nginx/snippets/sda-admin-2fa.conf
#   sudo sed -i 's|# include /etc/nginx/snippets/sda-admin-2fa.conf;|include /etc/nginx/snippets/sda-admin-2fa.conf;|' /etc/nginx/sites-enabled/sda
#   sudo nginx -t && sudo systemctl reload nginx

# Internal auth_request target. Companion listens on 127.0.0.1:21120.
location = /sda-admin-2fa-check {
    internal;
    proxy_pass http://127.0.0.1:21120/api/v1/admin-2fa/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /_admin {
    return 302 /_admin/;
}

location /_admin/ {
    auth_request /sda-admin-2fa-check;
    error_page 401 = @sda_admin_2fa_login;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_pass http://127.0.0.1:21114;
}

location @sda_admin_2fa_login {
    return 302 /companion/api/v1/admin-2fa;
}
