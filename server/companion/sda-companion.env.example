# Copy to /etc/sda-companion.env and fill in the SMTP account.
# Never commit the filled-in file.

COMPANION_HOST=0.0.0.0
COMPANION_PORT=21120
COMPANION_DATA=/var/lib/sda-companion

# Leave empty the first time. The service prints a token and saves it in
# COMPANION_DATA/admin-token. Paste that token into Smart Desktop Access Admin.
COMPANION_ADMIN_TOKEN=

# The owner's mailbox. If these are empty, Send email opens the admin's own
# mail program instead of sending from the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls, ssl, or none
SMTP_TLS=starttls
